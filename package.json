{
  "name": "hanmark",
  "version": "2.7.0",
  "description": "No-setup Markdown export to HWPX, self-contained HTML, and Editorial PDF.",
  "main": "main.js",
  "scripts": {
    "gen-assets": "node scripts/gen-embedded-assets.mjs && node scripts/gen-pdf-cmaps.mjs && node scripts/gen-form-templates.mjs && node scripts/gen-font-css.mjs",
    "dev": "npm run gen-assets && node esbuild.config.mjs",
    "build": "npm run gen-assets && tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "test:pdf-palette-exhaustive": "node --import tsx scripts/check-pdf-palette-exhaustive.ts",
    "lint": "eslint src package.json manifest.json --max-warnings 0",
    "check-bundle": "node scripts/check-bundle.mjs",
    "check-community": "node scripts/check-community.mjs",
    "check-release": "node scripts/check-release.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "check": "npm run lint && npm run check-i18n && npm run test && npm run build && npm run check-bundle && npm run check-community && npm run check-release",
    "test:pdf-render": "node --import tsx scripts/test-editorial-pdf-render.mjs",
    "test:pdf-ui": "node scripts/test-pdf-export-ui.mjs",
    "test:toolbar-ui": "node scripts/test-toolbar-ui.mjs",
    "test:preview-ui": "node scripts/test-preview-ui.mjs"
  },
  "keywords": [
    "hwp",
    "hwpx",
    "docx",
    "markdown",
    "kordoc"
  ],
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "docx-preview": "0.4.0",
    "jszip": "^3.10.1",
    "kordoc": "4.15.7",
    "markdown-it": "14.3.2",
    "markdown-it-footnote": "4.0.0",
    "pdfjs-dist": "4.10.38"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "adm-zip": "0.6.1",
    "body-parser": "2.3.0",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.2",
    "moment": "2.31.0",
    "protobufjs": "8.7.1",
    "sharp": "0.35.4",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@codemirror/view": "6.38.6",
    "@eslint/json": "0.14.0",
    "@fontsource/pretendard": "5.3.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "8.65.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.1",
    "obsidian": "^1.5.0",
    "playwright": "1.62.1",
    "tslib": "^2.8.1",
    "tsx": "4.21.0",
    "typescript": "^5.8.2"
  }
}
